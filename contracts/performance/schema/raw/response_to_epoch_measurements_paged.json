{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EpochMeasurementsPagedResponse",
  "type": "object",
  "required": [
    "epoch_id",
    "measurements"
  ],
  "properties": {
    "epoch_id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NodeMeasurements"
      }
    },
    "start_next_after": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "EpochNodeMeasurements": {
      "description": "Everything submitted for one node in one epoch, split by kind. Absent kinds are omitted from JSON.",
      "type": "object",
      "properties": {
        "c": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "l": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "s": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "NodeMeasurements": {
      "type": "object",
      "required": [
        "measurements",
        "node_id"
      ],
      "properties": {
        "measurements": {
          "$ref": "#/definitions/EpochNodeMeasurements"
        },
        "node_id": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "NodeResults": {
      "description": "Every monitor's value for one kind, as sorted integer percents.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      }
    }
  }
}
