{# Priority:
   1. Use moniker if provided in inventory
   2. Else strip "nym-exit." prefix if hostname starts with it
   3. Else use hostname unchanged
   4. Else (no hostname, e.g. mixnodes) use the inventory host name
#}

{% if moniker is defined and moniker | length > 0 %}
    {% set moniker_final = moniker %}
{% else %}
    {% set host = hostname | default('') %}
    {% if host.startswith('nym-exit.') %}
        {% set moniker_final = host | regex_replace('^nym-exit\\.', '') %}
    {% elif host | length > 0 %}
        {% set moniker_final = host %}
    {% else %}
        {% set moniker_final = inventory_hostname %}
    {% endif %}
{% endif %}

moniker = "{{ moniker_final }}"
website = " {{ website }}"
security_contact = "{{ email }}"
details = "{{ description }}"
