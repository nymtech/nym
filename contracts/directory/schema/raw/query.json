{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QueryMsg",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "admin"
      ],
      "properties": {
        "admin": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A single node entry.",
      "type": "object",
      "required": [
        "node_entry"
      ],
      "properties": {
        "node_entry": {
          "type": "object",
          "required": [
            "label",
            "node_id"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "node_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "A single curated entry.",
      "type": "object",
      "required": [
        "curated_entry"
      ],
      "properties": {
        "curated_entry": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "All entries for one node.",
      "type": "object",
      "required": [
        "node_entries"
      ],
      "properties": {
        "node_entries": {
          "type": "object",
          "required": [
            "node_id"
          ],
          "properties": {
            "node_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Paginated enumeration of all node entries, ordered by their key string.",
      "type": "object",
      "required": [
        "node_entries_paged"
      ],
      "properties": {
        "node_entries_paged": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "array",
                "null"
              ],
              "items": [
                {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                },
                {
                  "type": "string"
                }
              ],
              "maxItems": 2,
              "minItems": 2
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Paginated enumeration of all curated entries, ordered by their key string.",
      "type": "object",
      "required": [
        "curated_entries_paged"
      ],
      "properties": {
        "curated_entries_paged": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "Paginated enumeration of ALL entries (both namespaces) - the global pull a client uses to recompute and verify the digest.",
      "type": "object",
      "required": [
        "all_entries"
      ],
      "properties": {
        "all_entries": {
          "type": "object",
          "properties": {
            "limit": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0.0
            },
            "start_after": {
              "anyOf": [
                {
                  "$ref": "#/definitions/EntryKey"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The next sequence a node must sign with.",
      "type": "object",
      "required": [
        "sequence"
      ],
      "properties": {
        "sequence": {
          "type": "object",
          "required": [
            "node_id"
          ],
          "properties": {
            "node_id": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The compact 32-byte global digest.",
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "description": "The label whitelist with per-label sizes.",
      "type": "object",
      "required": [
        "allowed_labels"
      ],
      "properties": {
        "allowed_labels": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "definitions": {
    "EntryKey": {
      "description": "The logical key of a directory entry. Used as the [`crate::QueryMsg::AllEntries`] cursor / response key and to derive the canonical digest leaf; the on-chain storage key is handled separately by each per-class store (via `cw-storage-plus` `Path`/`Prefix`), so this type carries no storage-codec logic.\n\n- [`EntryKey::Node`] is keyed `(node_id, label)` - node entries are stored under one namespace, so all of a node's entries form a contiguous range (per-node query + unbond cleanup). - [`EntryKey::Curated`] is keyed by a single admin-chosen `key` string under a separate namespace; the admin is responsible for choosing a sensible path (there is no label/suffix structure imposed by the contract).",
      "oneOf": [
        {
          "description": "A self-published node entry, keyed `(node_id, label)`.",
          "type": "object",
          "required": [
            "node"
          ],
          "properties": {
            "node": {
              "type": "object",
              "required": [
                "label",
                "node_id"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "node_id": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0.0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "description": "An admin-curated entry, keyed by a single admin-chosen path string.",
          "type": "object",
          "required": [
            "curated"
          ],
          "properties": {
            "curated": {
              "type": "object",
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
