{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SequenceResponse",
  "description": "The next sequence a node must sign with (gap-free, exact-match).",
  "type": "object",
  "required": [
    "next_sequence"
  ],
  "properties": {
    "next_sequence": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
