.next
node_modules
out

# TypeScript incremental build cache (machine-specific, regenerated each build)
*.tsbuildinfo

# the lock file will break Vercel because it may get committed from a machine with a different build architecture
package-lock.json

# local env files
.env*.local
.env

scratch.md

# internal worklog scratchpads (kept local, not part of the PR / docs)
ai-assistant-mcp-scratch.md
ai-assistant-mcp-plan.md

# generated by next-sitemap at build time
sitemap*.xml
robots.txt

# Generated retrieval index + embed cache (built at deploy, served by Vercel)
public/docs-index.json
public/code-index.json
.cache/

# Per-page markdown export (built at deploy from pages/; see generate-page-markdown.mjs).
# Covers the operator pages too, which the operator team maintains and which had
# their own narrower rule before this pattern subsumed it.
public/*.md
public/**/*.md
