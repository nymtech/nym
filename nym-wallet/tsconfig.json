{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "jsx": "react-jsx",
    "sourceMap": true,
    // The shared ForkTsCheckerWebpackPlugin runs in `write-references` (emit) mode; with
    // `allowJs` this would emit `.js` next to sources, polluting `src` (breaks Jest) and
    // erroring "would overwrite input file". Redirect that emit to a throwaway dir.
    // (`tsc --noEmit` and ts-loader/ts-jest ignore this; webpack controls its own output.)
    "outDir": "./.tsbuild",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@assets/*": ["../assets/*"],
      "@tauri-apps/plugin-process": ["../node_modules/@tauri-apps/plugin-process"],
      "@storybook/react-webpack5": ["node_modules/@storybook/react-webpack5/dist/index.d.ts"],
      "storybook/test": ["node_modules/storybook/dist/test/index.d.ts"]
    }
  },

  "references": [{ "path": "./tsconfig.test.json" }],

  "exclude": [
    "node_modules",
    "dist",
    "jest.config.js",
    "webpack.config.js",
    "webpack.prod.js",
    "webpack.common.js",
    "target",
    "e2e",
    "e2e-tauri",
    "playwright.config.ts",
    "wdio.conf.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    ".tsbuild"
  ]
}
