{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NodeMeasurementsResponse",
  "type": "object",
  "properties": {
    "measurements": {
      "anyOf": [
        {
          "$ref": "#/definitions/EpochNodeMeasurements"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "EpochNodeMeasurements": {
      "description": "Everything submitted for one node in one epoch, split by kind. Absent kinds are omitted from JSON.",
      "type": "object",
      "properties": {
        "c": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "l": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "s": {
          "anyOf": [
            {
              "$ref": "#/definitions/NodeResults"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "NodeResults": {
      "description": "Every monitor's value for one kind, as sorted integer percents.",
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint8",
        "minimum": 0.0
      }
    }
  }
}
